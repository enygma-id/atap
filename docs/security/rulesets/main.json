{
  "name": "protect-main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "export-conformance"
          },
          {
            "context": "numpy-1"
          },
          {
            "context": "playground-e2e"
          },
          {
            "context": "release-metadata"
          },
          {
            "context": "test (ubuntu-24.04, 3.10)"
          },
          {
            "context": "test (ubuntu-24.04, 3.12)"
          },
          {
            "context": "test (windows-latest, 3.10)"
          },
          {
            "context": "test (windows-latest, 3.12)"
          },
          {
            "context": "uv-workflow (macos-latest)"
          },
          {
            "context": "uv-workflow (ubuntu-24.04)"
          },
          {
            "context": "uv-workflow (windows-latest)"
          },
          {
            "context": "CodeQL (actions)"
          },
          {
            "context": "CodeQL (javascript-typescript)"
          },
          {
            "context": "CodeQL (python)"
          },
          {
            "context": "Fuzz seeds (footprint_ids)"
          },
          {
            "context": "Fuzz seeds (profile)"
          },
          {
            "context": "Fuzz seeds (export)"
          }
        ]
      }
    }
  ]
}
